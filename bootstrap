#! /bin/sh

# This script helps bootstrap autoconf, when checked out from git.
#
# Copyright (C) 2021-2026 Free Software Foundation, Inc.
#
# This program is free software; you can redistribute it and/or modify
# it under the terms of the GNU General Public License as published by
# the Free Software Foundation; either version 2, or (at your option)
# any later version.
#
# This program is distributed in the hope that it will be useful,
# but WITHOUT ANY WARRANTY; without even the implied warranty of
# MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
# GNU General Public License for more details.
#
# You should have received a copy of the GNU General Public License
# along with this program.  If not, see <https://www.gnu.org/licenses/>.

# Autoconf's own configure script is generated using Autoconf.  This
# script does what running `autoreconf -i` in an Autoconf git checkout
# would do, except that it uses autoconf from the source tree we are
# preparing, not any version of autoconf that might or might not be
# installed already.  Note that automake, Perl, and GNU M4 _are_
# required to be installed already.

# Don't ignore failures.
set -e
(set -o pipefail 2> /dev/null) && set -o pipefail

# Error on undefined variables.
(set -u 2> /dev/null) && set -u

# Avoid problems due to various shell wrinkles.
# We assume we have a shell new enough to implement unset correctly.
(set -o posix 2> /dev/null) && set -o posix

PS1='$ '
PS2='> '
PS4='+ '
unset BASH_ENV CDPATH ENV IFS MAIL MAILPATH POSIXLY_CORRECT
unset LANG LANGUAGE LC_ADDRESS LC_COLLATE LC_CTYPE LC_IDENTIFICATION
unset LC_MEASUREMENT LC_MESSAGES LC_MONETARY LC_NAME LC_NUMERIC LC_PAPER
unset LC_TELEPHONE LC_TIME

LC_ALL=C
export LC_ALL

# Set program basename.
me=${0##*/}
usage="usage: $me [options]

Prepare to build a git checkout of autoconf.
Functionally equivalent to \`autoreconf -i\`, but uses autoconf code
from the git checkout itself to create \`configure\`.

Options:
  -f, --force      consider all files to be obsolete
  -v, --verbose    verbosely report processing (repeat for more detail)
"

# Options.
verbose=
subverbose=
force=
while [ $# -gt 0 ]; do
    case "$1" in
        (-v | --verbose)
            if [ -n "$verbose" ]; then
                subverbose=--verbose
            else
                verbose=--verbose
            fi
        ;;
        (-f | --force)
            force=--force
        ;;
        (-h | --help)
            printf '%s' "$usage"
            exit 0
        ;;
        (*)
            printf '%s' "$usage" >&2
            exit 1
        ;;
    esac
    shift
done


# Let the user choose which version of aclocal, automake, m4, and perl to use.
: ${ACLOCAL=aclocal}
: ${AUTOMAKE=automake}
# Reject known broken GNU M4 releases, but do not apply GNU version
# numbering to independent implementations.
m4_too_old()
{
    case "$1" in
      (*"GNU M4"*) ;;
      (*) return 1 ;;
    esac
    case "$1" in
      ( *\ 0.*                \
      | *\ 1.[0123]           \
      | *\ 1.[0123].*         \
      | *\ 1.4.[01234567]     \
      | *\ 1.4.1[012345]      \
      ) return 0 ;;
      (*) return 1 ;;
    esac
}

# Check the interfaces actually used by autom4te and M4sugar.  No
# implementation is accepted solely because of its name or version.
# The result is the validated option for writing trace files.
m4_probe() (
    m4_binary=$1
    probe_dir=$(mktemp -d "${TMPDIR:-/tmp}/autoconf-m4.XXXXXXXX") || exit 1
    trap 'rm -rf "$probe_dir"' 0
    # A signal must pass through EXIT cleanup with a recognizable status.
    trap 'exit 129' 1
    trap 'exit 130' 2
    trap 'exit 131' 3
    trap 'exit 143' 15

    m4_version=$("$m4_binary" --version 2>/dev/null | sed -n '1p') || m4_version=
    if m4_too_old "$m4_version"; then exit 1; fi

    m4_actual=$(printf '%s\n' \
        'changequote(<,>)indir(<ifelse>,<yes>,<yes>,<ok>,<bad>)' \
        'patsubst(<aba>,<b>,<X>)' \
        'regexp(<abc>,<b>,<found>)' \
        | "$m4_binary" --fatal-warning 2>/dev/null) || exit 1
    m4_expected=$(printf '%s\n' ok aXa found)
    test "$m4_actual" = "$m4_expected" || exit 1

    "$m4_binary" -F "$probe_dir/frozen" </dev/null >/dev/null 2>&1 || exit 1
    test -s "$probe_dir/frozen" || exit 1
    m4_actual=$(printf '%s\n' frozen-ok | \
        "$m4_binary" --reload-state="$probe_dir/frozen" \
        --fatal-warning 2>/dev/null) || exit 1
    test "$m4_actual" = frozen-ok || exit 1

    for m4_debug_opt in --debugfile --error-output; do
        rm -f "$probe_dir/trace"
        if printf '%s\n' \
            'changequote(<,>)define(<T>,<>)' \
            'define(<F>,<T(<traced>)>)' \
            'm4wrap(<F>)' \
            | "$m4_binary" --trace=T --debug=aflq \
                "$m4_debug_opt=$probe_dir/trace" >/dev/null 2>&1 \
            && test -s "$probe_dir/trace" \
            && grep -F 'T(<traced>)' "$probe_dir/trace" >/dev/null 2>&1
        then
            printf '%s\n' "$m4_debug_opt"
            exit 0
        fi
    done
    exit 1
)

# Explicit M4 is authoritative: report failure, never silently replace it.
if test "${M4+set}" = set; then
    if ! M4_DEBUGFILE=$(m4_probe "$M4"); then
        printf '%s\n' "$me: error: M4=$M4 lacks required Autoconf features" >&2
        exit 1
    fi
else
    M4=
    for m4_choice in gm4 m4 gnum4; do
        m4_candidate=$(command -v "$m4_choice") || continue
        if M4_DEBUGFILE=$(m4_probe "$m4_candidate"); then
            M4=$m4_candidate
            break
        fi
    done
    if test -z "$M4"; then
        printf '%s\n' "$me: error: no feature-compatible M4 found (traces, frozen states and GNU-style macro primitives required)" >&2
        exit 1
    fi
fi

# Embed the resolved executable path, not an ambiguous command name.
m4_resolved=$(command -v "$M4") || {
    printf '%s\n' "$me: error: cannot resolve M4 executable: $M4" >&2
    exit 1
}
case "$m4_resolved" in
    (/*) M4=$m4_resolved ;;
    (*) M4=$(CDPATH= cd -P "$(dirname "$m4_resolved")" && pwd)/$(basename "$m4_resolved") ;;
esac
: ${PERL=perl}
export ACLOCAL AUTOMAKE M4 PERL

# Allow 'ln -s' to be overridden by the user.
: ${LN_S="ln -s"}
export LN_S

# $PERL needs to be an absolute path because we're going to substitute it
# into #! lines.
set fnord $PERL
shift
PERL=$(command -v $1)
shift
if [ $# -gt 0 ]; then
    PERL="$PERL $*"
fi

# Override SHELL.  This is required on DJGPP so that Perl's system()
# uses bash, not COMMAND.COM which doesn't quote arguments properly.
# It's not used otherwise.
if test -n "${DJDIR-}"; then
  BOOTSTRAP_SHELL=/dev/env/DJDIR/bin/bash.exe
else
  BOOTSTRAP_SHELL=/bin/sh
fi

# GNU mode is optional; feature-compatible implementations need not
# support the GNU-specific flag.  Test the option, not --help text.
M4_GNU=
if "$M4" --gnu </dev/null >/dev/null 2>&1; then
    M4_GNU=--gnu
fi

# Autoconf's version number and identifiers.
RELEASE_YEAR=$(sed -ne 's/^RELEASE_YEAR=\([0-9][0-9]*\)$/\1/p' configure.ac)
VERSION=$(build-aux/git-version-gen .tarball-version)

# PACKAGE_NAME and PACKAGE_BUGREPORT from the bootstrap autoconf can
# get copied into the generated configure script, so we need to get them
# right.  Caution: there is a hard tab in one of the regexes below.
PACKAGE_NAME=$(sed -n < configure.ac \
   -e 's/^m4_define(\[autoconf_PACKAGE_NAME], \[\([^]]*\)])$/\1/p')
PACKAGE_BUGREPORT=$(sed -n < configure.ac \
   -e 's/^m4_define(\[autoconf_PACKAGE_BUGREPORT], \[\([^]]*\)])$/\1/p')

if [ -z "$RELEASE_YEAR" ]; then
    printf >&2 '%s\n' \
      "$me: error: could not extract RELEASE_YEAR from configure.ac"
    exit 1
fi
if [ -z "$VERSION" ]; then
    printf >&2 '%s\n' "$me: error: could not compute VERSION"
    exit 1
fi
if [ -z "$PACKAGE_NAME" ]; then
    printf >&2 '%s\n' \
      "$me: error: could not extract PACKAGE_NAME from configure.ac"
    exit 1
fi
if [ -z "$PACKAGE_BUGREPORT" ]; then
    printf >&2 '%s\n' \
      "$me: error: could not extract PACKAGE_BUGREPORT from configure.ac"
    exit 1
fi

# PACKAGE_TARNAME and PACKAGE_URL from the bootstrap autoconf should not
# get copied into the configure script.
PACKAGE_URL='<<not available>>'
PACKAGE_TARNAME='<<not available>>'

# Keep bootstrap-generated tools outside the source checkout.  Their path
# is embedded in AUTOM4TE with command-line options and must have no spaces.
# This also permits source trees in directories whose names contain spaces.
bootstrap_tmpdir=${TMPDIR:-/tmp}
case "$bootstrap_tmpdir" in
    *[[:space:]]*) bootstrap_tmpdir=/tmp ;;
esac
ACBOOTDIR=$(mktemp -d "$bootstrap_tmpdir/acboot.XXXXXXXXXX") || {
    printf '%s\n' "$me: error: cannot create bootstrap tool directory" >&2
    exit 1
}
# Register cleanup before canonicalization: cd -P can fail if the temporary
# directory is deleted or made inaccessible between mktemp and cd.
# Keep the original pathname immutable so the exit trap never uses a partly
# resolved assignment.
acboot_created=$ACBOOTDIR
trap 'rm -rf "$acboot_created"' 0
trap 'exit 129' 1
trap 'exit 130' 2
trap 'exit 131' 3
trap 'exit 143' 15
ACBOOTDIR=$(CDPATH= cd -P "$ACBOOTDIR" && pwd -P) || exit 1
case "$ACBOOTDIR" in
    *[[:space:]]*)
        printf '%s\n' "$me: error: temporary bootstrap path contains whitespace: $ACBOOTDIR" >&2
        exit 1
        ;;
esac
bootstrap_srcdir=$(pwd -P)

# Prepare config.status-like substitutions once for all bootstrap outputs.
# A path may contain &, % or backslashes; none may become sed syntax.
substitutions="$ACBOOTDIR/substitutions.sed"
: > "$substitutions"
append_substitution ()
{
    subst_key=$1
    subst_value=$2
    case "$subst_value" in
        *'
'*)
            printf '%s: error: newline in bootstrap substitution: %s\n' \
                "$me" "$subst_key" >&2
            return 1 ;;
    esac
    subst_escaped=$(printf '%s' "$subst_value" |
                    sed 's/[\\&%]/\\&/g') || return 1
    printf 's%%@%s@%%%s%%g\n' "$subst_key" "$subst_escaped" >> "$substitutions"
}

append_substitution M4 "$M4"
append_substitution M4_DEBUGFILE "$M4_DEBUGFILE"
append_substitution M4_GNU "$M4_GNU"
append_substitution PACKAGE_BUGREPORT "$PACKAGE_BUGREPORT"
append_substitution PACKAGE_NAME "$PACKAGE_NAME"
append_substitution PACKAGE_STRING "$PACKAGE_NAME $VERSION"
append_substitution PACKAGE_TARNAME "$PACKAGE_TARNAME"
append_substitution PACKAGE_URL "$PACKAGE_URL"
append_substitution PACKAGE_VERSION "$VERSION"
append_substitution PERL "$PERL"
append_substitution PERL_FLOCK 0
append_substitution RELEASE_YEAR "$RELEASE_YEAR"
append_substitution SHELL "$BOOTSTRAP_SHELL"
append_substitution VERSION "$VERSION"
append_substitution pkgdatadir "$ACBOOTDIR/lib"

# dosubst options infile outfile -- performs substitutions like config.status.
# INFILE is relative to the source tree; OUTFILE is relative to $ACBOOTDIR.
# If OPTIONS is 'x', OUTFILE becomes executable.
dosubst ()
{
    in=${2##*/}
    out="$ACBOOTDIR/$3"
    if [ -n "$verbose" ]; then
        printf '%s: creating %s\n' "$me" "$out"
    fi
    rm -f "$out"
    sed -e "s%@configure_input@%Generated from $in; do not edit by hand.%g" \
        -f "$substitutions" "$2" > "$out"
    if [ "$1" = "x" ]; then
        chmod +x "$out"
    fi
}

# Create the bootstrap installation.
mkdir "$ACBOOTDIR"/bin "$ACBOOTDIR"/lib "$ACBOOTDIR"/tmp
(
    cd "$ACBOOTDIR"/lib
    for sub in Autom4te autoconf m4sugar ; do
        if [ -n "$verbose" ]; then
            printf '%s: creating %s\n' "$me" "$ACBOOTDIR/lib/$sub"
        fi
        $LN_S "$bootstrap_srcdir/lib/$sub" .
    done
)

# automake invokes autoconf, and autoconf and aclocal both invoke autom4te,
# so we need to create both of them.
dosubst x bin/autoconf.in bin/autoconf
dosubst x bin/autom4te.in bin/autom4te
dosubst . lib/autom4te.in lib/autom4te.cfg
dosubst . lib/autoconf_version.in lib/autoconf_version.m4

AUTOCONF="$ACBOOTDIR"/bin/autoconf
AUTOM4TE="$ACBOOTDIR/bin/autom4te -M -C $ACBOOTDIR/tmp/autom4te.cache"
export AUTOCONF AUTOM4TE

# We can now do what autoreconf would have done.
# Order is critical -- first aclocal, then autoconf, then automake.
run ()
{
    if [ -n "$verbose" ]; then
        printf '%s: running %s\n' "$me" "$*"
    fi
    "$@"
}

run $ACLOCAL -I m4 -Wall -Werror $subverbose $force
run $AUTOCONF -Wall -Werror $subverbose $force
run $AUTOMAKE --add-missing --copy -Wall -Werror $subverbose $force

# The EXIT trap removes the temporary bootstrap installation.
